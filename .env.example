# Copier ce fichier en `.env` avant `docker compose up` (les valeurs vides bloquent le démarrage, volontairement).
# docker compose lit automatiquement le fichier .env situé à côté de docker-compose.yml.

# Mot de passe root MySQL, utilisé par l'API pour se connecter à la base.
DB_PASSWORD=change-me

# Clé de signature JWT : 32 caractères minimum. Générer par exemple :
#   openssl rand -base64 48
JWT_SECRET=

# Origines autorisées pour CORS. Inutile de le changer si vous passez par le front nginx (même origine).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cookie du refresh token : marqué Secure par défaut. Ne passer à false que si vous exposez le stack
# en HTTP simple sur une adresse autre que localhost — le navigateur jetterait sinon le cookie.
REFRESH_COOKIE_SECURE=true
